# Upstox developer app credentials — from https://account.upstox.com/developer/apps
# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real secrets.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Optional: if the Upstox developer dashboard offers a "Generate access token"
# button directly on the app page, paste that token here instead — skips the
# OAuth login/callback flow entirely. Note it still expires daily (Upstox
# tokens are valid until ~3:30am IST the next day either way).
UPSTOX_ACCESS_TOKEN=

# Optional: Supabase project — enables persistence for pcr_snapshots
# (backend.py) and, for the Nifty Pre-Market Analysis Engine addition
# (docs/PREMARKET_ENGINE.md), participant_oi / fii_dii_cash /
# macro_snapshots / morning_briefs (storage.py). Everything runs fine
# without these set — writes just no-op.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Nifty Pre-Market Analysis Engine (main.py / api/premarket.py):
# - PREMARKET_JOB_API_KEY: required to call POST /api/premarket/jobs/evening
#   and /morning (checked against the X-API-Key header). Also set as a
#   GitHub Actions secret of the same name for .github/workflows/premarket_jobs.yml.
# - CORS_ORIGIN: the dashboard's dev/prod origin allowed to call this API.
#   Defaults to http://localhost:5173 (Vite's default) if unset.
PREMARKET_JOB_API_KEY=
CORS_ORIGIN=

# notify.py — Telegram delivery of the morning brief. Get a bot token from
# @BotFather; chat ID is your own user ID (or a group's) — message the bot
# once and check https://api.telegram.org/bot<token>/getUpdates to find it.
# Leaving these unset just means the morning job doesn't notify anyone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# news_ai.py — Gemini Flash headline classifier. Get a key from
# https://aistudio.google.com/apikey. Leaving GEMINI_API_KEY unset just
# means headlines come back with neutral sentiment and a note, same as any
# other unconfigured optional source. GEMINI_MODEL defaults to a best-guess
# current Flash model id — check https://ai.google.dev/gemini-api/docs/models
# and override here if it's gone stale.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional free-tier fallback for when Gemini errors or times out (e.g. a
# transient 503 "high demand" from Google). Get a key from
# https://openrouter.ai/settings/keys — free, no card required. Usage here
# is ~2 calls/day, well under the free tier's no-purchase daily cap.
# OPENROUTER_MODEL defaults to a free model id (openai/gpt-oss-20b:free) —
# check https://openrouter.ai/models?max_price=0 for current free options
# if it's ever retired.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional Index Contribution & Early-Warning Engine overrides (also in
# config/index_engine.json — env wins over the file, runtime PUT /api/index-engine/config
# wins over both for the life of that process).
INDEX_ENGINE_POLL_SECONDS=
INDEX_ENGINE_PERSIST_SECONDS=
INDEX_ENGINE_ALERT_THRESHOLD=
INDEX_ENGINE_COOLDOWN_MINUTES=
INDEX_ENGINE_LOOKAHEAD_MINUTES=
INDEX_ENGINE_MOVE_THRESHOLD_PTS=
